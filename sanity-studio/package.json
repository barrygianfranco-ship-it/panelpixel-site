{
  "name": "panel-pixel",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "build:site-preview": "esbuild scripts/site-visual-editing-entry.js --bundle --format=iife --platform=browser --target=es2022 --minify --outfile=../js/sanity-visual-editing.js",
    "deploy": "sanity deploy",
    "deploy:production": "sanity deploy --url panelpixel --yes --schema-required",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/visual-editing": "6.1.3",
    "@sanity/vision": "^6.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.19.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^7",
    "@types/react": "^19.2.14",
    "esbuild": "0.28.2",
    "eslint": "^10.8.1",
    "prettier": "^3.5",
    "typescript": "~6.0"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
